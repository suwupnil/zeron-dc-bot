# Discord Configuration
# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord Application ID (from Discord Developer Portal -> General Information)
APPLICATION_ID=123456789012345678

# Optional: Guild ID for instant slash command registration during development.
# If omitted, slash commands will be registered globally (may take up to 1 hour to propagate).
# GUILD_ID=123456789012345678

# Zeron Engine Configuration
# Path to the zeron binary. Default search path includes zeron in $PATH or /Applications/Zeron.app/Contents/MacOS/zeron
ZERON_PATH=zeron

# Default harness to use when creating new chat sessions (e.g., codex, claude-code, devin, antigravity)
DEFAULT_HARNESS=codex

# Default model to use (omit to use harness default, or specify e.g. gpt-6.1-sol, claude-sonnet-5)
# DEFAULT_MODEL=gpt-6.1-sol

# Default project directory / working directory on the host VM (e.g., /home/ubuntu/projects or ~/projects)
DEFAULT_PROJECT_DIR=/home/ubuntu/projects

# Bot Behavior
# Automatically initialize a Zeron chat session when joining a text channel (default: true)
AUTO_CREATE_SESSIONS=true

# Discord Command / Mention prefix for text fallback (default: !z)
COMMAND_PREFIX=!z

# Path to persist channel and thread session mappings across restarts
SESSION_STORAGE_PATH=./sessions.json

# Cloudflare Decision Model Configuration (Multi-user channel intervention filter)
# If configured, uses Cloudflare Workers AI ("clef flash" / @cf/cloudflare/clef-flash)
# to evaluate whether incoming messages in multi-user channels request bot assistance.
# When unconfigured, an intelligent heuristic fallback is used automatically.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Optional: Cloudflare OAuth refresh token for automatic token renewal
CLOUDFLARE_REFRESH_TOKEN=
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash
CLOUDFLARE_AI_ENDPOINT=https://api.cloudflare.com/client/v4/accounts/.../ai/run/...

# Multimodal & Media Processing Configuration
# Directory to cache downloaded media files (images, audio, documents)
MEDIA_CACHE_DIR=./media_cache

# Maximum allowed file sizes in bytes (default: 25MB for images/audio, 50MB for general files)
MEDIA_MAX_IMAGE_BYTES=25000000
MEDIA_MAX_AUDIO_BYTES=25000000
MEDIA_MAX_FILE_BYTES=50000000

# Path to ffmpeg binary (required to transcode Discord audio/voice notes to 16kHz mono WAV for STT)
FFMPEG_PATH=ffmpeg

# Speech-to-Text (STT) Provider: groq | cloudflare | openai | none
# - groq: Uses Groq Cloud Whisper API (whisper-large-v3-turbo) via GROQ_API_KEY
# - cloudflare: Uses Cloudflare Workers AI Whisper with CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN
# - openai: Uses OpenAI Whisper API (requires OPENAI_API_KEY)
# - none: Disables automatic transcription
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=
OPENAI_API_KEY=

# Optical Character Recognition (OCR) / Vision Provider: cloudflare | tesseract | none
# - cloudflare: Uses Cloudflare Workers AI vision model (@cf/llava-hf/llava-1.5-7b-hf)
# - tesseract: Uses local Tesseract OCR binary CLI (requires tesseract installed)
# - none: Disables automatic image OCR
OCR_PROVIDER=cloudflare
OCR_MODEL=@cf/llava-hf/llava-1.5-7b-hf
TESSERACT_PATH=tesseract

# Magpie & Terminal Discord Embedded Activities
# Required for /magpie and /terminal slash commands to launch embedded activities.
# MAGPIE_URL is the public HTTPS URL of your Cloudflare Worker activity reverse proxy.
# UPDATE_SECRET is the shared Bearer token configured in the Worker for activity mode coordination.
# Both are strictly required for /magpie and /terminal to coordinate activity switching and launch safely.
# MAGPIE_URL=https://magpie-activity.your-worker.workers.dev
# UPDATE_SECRET=your_update_secret_token_here

# Logging level: trace, debug, info, warn, error
RUST_LOG=info
