[Unit]
Description=Terminal Bridge — WebSocket to SSH proxy for Discord Activity
After=network.target

[Service]
Type=simple
User=<YOUR_USER>
WorkingDirectory=/home/<YOUR_USER>
ExecStart=/usr/bin/node /home/<YOUR_USER>/terminal-bridge.js
Restart=always
RestartSec=5
EnvironmentFile=/home/<YOUR_USER>/.terminal-bridge.env

[Install]
WantedBy=multi-user.target
