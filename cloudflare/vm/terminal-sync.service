[Unit]
Description=Sync Terminal Bridge Tunnel URL to Cloudflare Worker
After=terminal-tunnel.service network.target
Wants=terminal-tunnel.service

[Service]
Type=simple
User=<YOUR_USER>
WorkingDirectory=/home/<YOUR_USER>
ExecStart=/home/<YOUR_USER>/sync-terminal-to-worker.sh
Restart=always
RestartSec=5
EnvironmentFile=-/home/<YOUR_USER>/.terminal-bridge.env
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
